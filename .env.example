# ==========================================
# BPSchool AI Executive Hub - Environment Config
# ==========================================

# 1. LINE Messaging API (ได้จาก LINE Developers Console)
LINE_CHANNEL_SECRET=your_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# 2. LINE ID ผู้รับรายงาน (User ID หรือ Group ID ของกลุ่มทดสอบ/ผอ.)
LINE_TARGET_ID=your_test_user_or_group_id_here

# 3. Google Gemini AI API Key (สำหรับประมวลผลสรุป)
GEMINI_API_KEY=your_gemini_api_key_here

# 4. Environment Mode (development / production)
NODE_ENV=production
